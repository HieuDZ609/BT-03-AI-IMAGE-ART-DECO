
digraph ERD {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.45, ranksep=0.55, bgcolor="white", pad=0.12];
  node  [shape=plaintext, fontname="DejaVu Sans", fontsize=9.5];
  edge  [fontname="DejaVu Sans", fontsize=8.5, color="#8A6D1F", arrowsize=0.65, penwidth=1.1];

  members [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#FBF6E9" color="#C9A227"><tr><td bgcolor="#C9A227" colspan="2"><b>members</b></td></tr><tr><td align="left" port="member_id (PK)"><b>member_id (PK)</b></td><td align="left">smallint</td></tr><tr><td align="left" port="student_code">student_code</td><td align="left">varchar · unique</td></tr><tr><td align="left" port="full_name">full_name</td><td align="left">varchar</td></tr><tr><td align="left" port="is_leader">is_leader</td><td align="left">boolean</td></tr></table>>];

  workers [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#FBF6E9" color="#C9A227"><tr><td bgcolor="#C9A227" colspan="2"><b>ai_workers</b></td></tr><tr><td align="left" port="worker_id (PK)"><b>worker_id (PK)</b></td><td align="left">smallint</td></tr><tr><td align="left" port="member_id (FK)">member_id (FK)</td><td align="left">→ members</td></tr><tr><td align="left" port="ai_code">ai_code</td><td align="left">varchar · unique · “4.1”</td></tr><tr><td align="left" port="model_name">model_name</td><td align="left">varchar</td></tr><tr><td align="left" port="hostname">hostname</td><td align="left">varchar</td></tr><tr><td align="left" port="status">status</td><td align="left">ONLINE / OFFLINE</td></tr><tr><td align="left" port="last_heartbeat">last_heartbeat</td><td align="left">timestamptz</td></tr><tr><td align="left" port="total_generated">total_generated</td><td align="left">bigint</td></tr></table>>];

  images [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#FBF6E9" color="#C9A227"><tr><td bgcolor="#C9A227" colspan="2"><b>images</b></td></tr><tr><td align="left" port="image_id (PK)"><b>image_id (PK)</b></td><td align="left">uuid</td></tr><tr><td align="left" port="image_name">image_name</td><td align="left">“black dog 4.1.png”</td></tr><tr><td align="left" port="slug">slug</td><td align="left">varchar · index trgm</td></tr><tr><td align="left" port="prompt">prompt</td><td align="left">text</td></tr><tr><td align="left" port="style_id">style_id</td><td align="left">varchar · “deco-v1”</td></tr><tr><td align="left" port="worker_id (FK)">worker_id (FK)</td><td align="left">→ ai_workers</td></tr><tr><td align="left" port="storage_key">storage_key</td><td align="left">varchar · unique</td></tr><tr><td align="left" port="sha256">sha256</td><td align="left">char(64) · unique</td></tr><tr><td align="left" port="width / height">width / height</td><td align="left">smallint</td></tr><tr><td align="left" port="format / file_size">format / file_size</td><td align="left">varchar / int</td></tr><tr><td align="left" port="created_at">created_at</td><td align="left">timestamptz · index</td></tr></table>>];

  jobs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#FBF6E9" color="#C9A227"><tr><td bgcolor="#C9A227" colspan="2"><b>generation_jobs</b></td></tr><tr><td align="left" port="job_id (PK)"><b>job_id (PK)</b></td><td align="left">uuid</td></tr><tr><td align="left" port="query / slug">query / slug</td><td align="left">varchar</td></tr><tr><td align="left" port="source">source</td><td align="left">SEARCH / AUTOPILOT</td></tr><tr><td align="left" port="status">status</td><td align="left">QUEUED → DONE</td></tr><tr><td align="left" port="worker_id (FK)">worker_id (FK)</td><td align="left">→ ai_workers</td></tr><tr><td align="left" port="attempts">attempts</td><td align="left">smallint</td></tr><tr><td align="left" port="duration_ms">duration_ms</td><td align="left">integer</td></tr><tr><td align="left" port="image_id (FK)">image_id (FK)</td><td align="left">→ images</td></tr><tr><td align="left" port="error">error</td><td align="left">text</td></tr></table>>];

  logs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#F2F8F7" color="#1E6E6B"><tr><td bgcolor="#1E6E6B" colspan="2"><b>search_logs</b></td></tr><tr><td align="left" port="log_id (PK)"><b>log_id (PK)</b></td><td align="left">bigint</td></tr><tr><td align="left" port="query">query</td><td align="left">varchar</td></tr><tr><td align="left" port="hit">hit</td><td align="left">boolean</td></tr><tr><td align="left" port="job_id">job_id</td><td align="left">uuid</td></tr><tr><td align="left" port="created_at">created_at</td><td align="left">timestamptz</td></tr></table>>];

  members -> workers [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  workers -> images  [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  workers -> jobs    [label="1 : N", arrowhead=crow, arrowtail=tee, dir=both];
  jobs    -> images  [label="0..1 : 1"];
  jobs    -> logs    [label="1 : 0..1", style=dashed];

  {rank=same; images; jobs;}
}
